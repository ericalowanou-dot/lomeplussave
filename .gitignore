# --- FICHIERS SENSIBLES ET UPLOADS ---
# Fichiers de configuration sensibles
*.env.local
*.env.*.local
config/database.php
config/mail.php

# Fichiers uploadés par les utilisateurs
/public/advertisements/*
/public/articles/*
/public/users/profil/*
/public/images/*
/public/publicites/*

# Dossiers de build et assets compilés
/public/build*
/public/js*
/public/images*

# Scripts promo / icônes versionnés (hors /public/js* et /public/images* ignorés)
!/public/assets/
!/public/assets/promo/
!/public/assets/promo/**
!/public/assets/icons/
!/public/assets/icons/**

# Démos spotlight versionnées
!/public/media/
!/public/media/spotlight/
!/public/media/spotlight/**

# Anciennes copies de backup (css1, build2, images1, etc.)
/public/css[0-9]/
/public/build[0-9]/
/public/images[0-9]/
/public/articles[0-9]/
/public/js[0-9]/
/public/index[0-9].php
/public/.htaccess[0-9]

# Bootstrap Icons : css + polices uniquement (pas les milliers de .svg)
/public/css/bootstrap-icons/*.svg
/public/css/*.zip

# Fichiers de logs et cache
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*

# Fichiers temporaires
*.log
*.tmp
*.cache
.DS_Store
Thumbs.db

# Scripts et fichiers de démarrage locaux
start.sh
scripts/
# ... sauf les scripts de build versionnés (ex: generation du precache Service Worker PWA)
!/scripts/
!/scripts/**

